---
import Base from '../layouts/Base.astro';
import { Index } from '../components/home.jsx';
import { softwareApplicationSchema, faqPageSchema, webPageSchema, SITE_DESCRIPTION } from '../lib/seo.js';
import { HOME_FAQ } from '../lib/faqs.js';

const jsonLd = [
  softwareApplicationSchema(),
  webPageSchema({
    name: 'Revly | Review management for software companies',
    description: SITE_DESCRIPTION,
    path: '/',
    image: '/og-image.png',
  }),
  faqPageSchema(HOME_FAQ),
];
---
<Base
  title="Revly | Review management for software companies"
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <!-- Revly's own Intercom Messenger (workspace nihx4xym — same one the
         app boots for signed-in users). source_site is a custom visitor
         attribute: filter or route on "source_site is marketing" in Intercom
         to treat homepage conversations differently from in-app ones.
         Conversations also carry the started-from page URL automatically. -->
    <script is:inline>
      window.intercomSettings = {
        app_id: 'nihx4xym',
        source_site: 'marketing',
      };
    </script>
    <!-- Intercom's official snippet, except the ~230 KB widget loads on the visitor's
         first interaction instead of on page load. Loading it up front cost about
         130ms of main-thread blocking on mobile and delayed the hero's paint (Lighthouse,
         Nov 2026). The Intercom() queue stub is still created immediately, so any
         call made before the widget arrives is replayed once it does. -->
    <script is:inline>
      (function(){var w=window;var ic=w.Intercom;if(typeof ic==="function"){ic('reattach_activator');ic('update',w.intercomSettings);return;}
      var d=document;var i=function(){i.c(arguments);};i.q=[];i.c=function(args){i.q.push(args);};w.Intercom=i;
      var done=false;var ev=['pointerdown','keydown','touchstart','scroll','mousemove'];
      var l=function(){if(done)return;done=true;ev.forEach(function(e){w.removeEventListener(e,l,{passive:true});});
        var s=d.createElement('script');s.type='text/javascript';s.async=true;s.src='https://widget.intercom.io/widget/nihx4xym';var x=d.getElementsByTagName('script')[0];x.parentNode.insertBefore(s,x);};
      ev.forEach(function(e){w.addEventListener(e,l,{passive:true});});})();
    </script>
  </Fragment>
  <Index client:load />
</Base>
