---
import Base from '../layouts/Base.astro';
import { CollectBetterReviews } from '../components/products.jsx';
import { faqPageSchema, webPageSchema, softwareApplicationSchema } from '../lib/seo.js';
import { COLLECT_FAQ } from '../lib/faqs.js';

const path = '/collect-quality-reviews';
const ogImage = '/assets/og-collect-quality-reviews.png';
const description =
  'One link checks in with your customer, routes anyone who needs help to your team, and helps the rest write a detailed review on the right platform.';

const jsonLd = [
  softwareApplicationSchema(undefined, "Revly checks in with each customer before asking for a review, routes anyone who needs help to your team, and helps everyone else write a detailed review on the platform you need."),
  webPageSchema({
    name: 'Turn "great tool" into a review that converts.',
    description,
    path,
    image: ogImage,
    breadcrumbName: 'Collect quality reviews',
  }),
  faqPageSchema(COLLECT_FAQ, path),
];
---
<Base
  title="Collect Better Software Reviews on G2 & Capterra | Revly"
  description={description}
  canonicalPath={path}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <CollectBetterReviews client:load />
</Base>
