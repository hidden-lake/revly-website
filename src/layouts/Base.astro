---
import { organizationSchema, websiteSchema } from '../lib/seo.js';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: object[];
}
const { title, description, canonicalPath, jsonLd = [] } = Astro.props;
const pathname = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(pathname, 'https://revly.io').toString();
// Site-wide schemas on every page, plus any page-specific schemas passed in.
const schemas = [organizationSchema, websiteSchema, ...jsonLd];
// Escape sequences that could break out of the <script> element. Schema content
// is currently all hardcoded, but this keeps the layout safe if any field ever
// comes from CMS/user-authored content.
const serializeJsonLd = (value) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XP8XN3QKR7"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-XP8XN3QKR7');
  </script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content="https://revly.io/og-image.png"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Revly"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content="https://revly.io/og-image.png"/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/styles.css"/>
  <link rel="stylesheet" href="/feature-collect.css"/>
  <link rel="stylesheet" href="/feature-hero.css"/>
  <link rel="stylesheet" href="/usecase-hero.css"/>
  <link rel="stylesheet" href="/usecase-sections.css"/>
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
  ))}
  <slot name="head"/>
</head>
<body>
  <slot/>
</body>
</html>
