---
import { organizationSchema, websiteSchema, canonicalUrl, SITE_URL } from '../lib/seo.js';

// Stylesheets are imported rather than linked out of public/, so Astro bundles
// the set into a single request. As eight separate <link> tags they were eight
// render-blocking round trips — roughly 1.5s before first paint on a throttled
// mobile connection, and the largest thing standing between a phone and the
// homepage. Import order IS cascade order: fonts first, then styles.css, which
// defines the custom properties every other file reads.
import '../styles/fonts.css';
import '../styles/styles.css';
import '../styles/feature-collect.css';
import '../styles/feature-hero.css';
import '../styles/feature-extra.css';
import '../styles/usecase-hero.css';
import '../styles/usecase-sections.css';
import '../styles/blog.css';
import '../styles/slack.css';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: object[];
  /** Page-specific social card, as a site-root path. Falls back to the site-wide one. */
  ogImage?: string;
}
const { title, description, canonicalPath, jsonLd = [], ogImage } = Astro.props;
const pathname = canonicalPath ?? Astro.url.pathname;
// Always the trailing-slash form, which is the URL that actually serves a 200.
const canonical = canonicalUrl(pathname);
const socialImage = `${SITE_URL}${ogImage ?? '/og-image.png'}`;
// Site-wide schemas on every page, plus any page-specific schemas passed in.
const schemas = [organizationSchema, websiteSchema, ...jsonLd];
// Escape sequences that could break out of the script element. Schema content
// is currently all hardcoded, but this keeps the layout safe if any field ever
// comes from CMS/user-authored content.
const serializeJsonLd = (value) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XP8XN3QKR7"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-XP8XN3QKR7');
  </script>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={socialImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="Revly"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={socialImage}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  {/* The two faces every page needs immediately. They are declared inside the
      bundled CSS, so without a preload the browser cannot discover them until it
      has parsed that stylesheet. The latin-ext and italic files are deliberately
      left out — unicode-range fetches those only if a page uses them. crossorigin
      is required on font preloads even same-origin, or the file is fetched twice. */}
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin/>
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
  ))}
  <slot name="head"/>
</head>
<body>
  <slot/>
</body>
</html>
